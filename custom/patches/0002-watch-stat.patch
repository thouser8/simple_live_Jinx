diff --git a/simple_live_tv_app/lib/services/watch_stat_service.dart b/simple_live_tv_app/lib/services/watch_stat_service.dart
new file mode 100644
--- /dev/null
+++ b/simple_live_tv_app/lib/services/watch_stat_service.dart
@@ -0,0 +1,129 @@
+import 'dart:async';
+
+import 'package:get/get.dart';
+import 'package:hive/hive.dart';
+
+/// 主播累计观看时长（纯本地统计，不上传）
+///
+/// 归集键：`站点ID_房间号`，与关注记录的键保持一致。
+/// 数据存在独立的 Hive 盒子里，不碰上游已有的任何 box，
+/// 因此上游改动数据结构也不影响这里。
+class WatchStatService {
+  WatchStatService._();
+
+  static final WatchStatService instance = WatchStatService._();
+
+  static const String boxName = "TVJinxWatchStat";
+
+  /// 每 20 秒落一次盘：进程被系统杀掉时最多丢 20 秒
+  static const Duration flushInterval = Duration(seconds: 20);
+
+  /// 秒数快照，供界面 Obx 订阅
+  final RxMap<String, int> seconds = <String, int>{}.obs;
+
+  Box<dynamic>? _box;
+  Future<void>? _loading;
+  Timer? _flushTimer;
+  String? _key;
+  DateTime? _segmentStart;
+
+  static String keyOf(String siteId, String roomId) => "${siteId}_$roomId";
+
+  Future<void> ensureReady() => _loading ??= _load();
+
+  Future<void> _load() async {
+    try {
+      final box = await Hive.openBox(boxName);
+      _box = box;
+      for (final k in box.keys) {
+        final v = box.get(k);
+        if (v is int && v > 0) {
+          seconds["$k"] = v;
+        }
+      }
+    } catch (_) {
+      // 统计库打不开时不影响播放，退化为仅本次运行内统计
+    }
+  }
+
+  int secondsOf(String siteId, String roomId) =>
+      seconds[keyOf(siteId, roomId)] ?? 0;
+
+  /// 卡片上显示的文字。不足 1 分钟或没有记录时返回 null（不显示徽标）
+  String? labelOf(String siteId, String roomId) {
+    final total = secondsOf(siteId, roomId);
+    final minutes = total ~/ 60;
+    if (minutes < 1) {
+      return null;
+    }
+    final hours = minutes ~/ 60;
+    final rest = minutes % 60;
+    if (hours < 1) {
+      return "${rest}分钟";
+    }
+    if (rest == 0) {
+      return "${hours}小时";
+    }
+    return "${hours}小时${rest}分";
+  }
+
+  /// 进入直播间：结算上一段，开始新的一段
+  void beginWatch(String siteId, String roomId) {
+    final next = keyOf(siteId, roomId);
+    if (_key == next && _segmentStart != null) {
+      return;
+    }
+    _flush();
+    _key = next;
+    _segmentStart = DateTime.now();
+    _flushTimer?.cancel();
+    _flushTimer = Timer.periodic(flushInterval, (_) => _flush());
+    unawaited(ensureReady());
+  }
+
+  /// 进入后台：停止计时，但保留当前房间
+  void pauseWatch() {
+    _flush();
+    _segmentStart = null;
+  }
+
+  void resumeWatch() {
+    if (_key == null || _segmentStart != null) {
+      return;
+    }
+    _segmentStart = DateTime.now();
+  }
+
+  /// 离开直播间
+  void endWatch() {
+    _flush();
+    _flushTimer?.cancel();
+    _flushTimer = null;
+    _key = null;
+    _segmentStart = null;
+  }
+
+  void _flush() {
+    final key = _key;
+    final start = _segmentStart;
+    if (key == null || start == null) {
+      return;
+    }
+    final now = DateTime.now();
+    final delta = now.difference(start).inSeconds;
+    if (delta <= 0) {
+      return;
+    }
+    _segmentStart = now;
+    addSeconds(key, delta);
+  }
+
+  void addSeconds(String key, int delta) {
+    final current = (seconds[key] ?? 0) + delta;
+    seconds[key] = current;
+    final box = _box;
+    if (box != null) {
+      unawaited(box.put(key, current));
+    }
+  }
+}
